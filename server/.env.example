PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/money-dashboard
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Where the React app runs (used in the verification link and CORS)
CLIENT_URL=http://localhost:5173

# Email (for verification). Leave SMTP_HOST empty in development:
# the verification link is then printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Money Dashboard <no-reply@example.com>"
